{
  "name": "Kajabi Quiz Report Delivery",
  "nodes": [
    {
      "id": "webhook-supabase-insert",
      "name": "Supabase Insert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "kajabi-quiz-report",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "http-kajabi-form-submission",
      "name": "Submit to Kajabi Form",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 0],
      "parameters": {
        "method": "POST",
        "url": "https://www.capturegreatness.org/forms/2149687265/form_submissions",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "form_submission[email]",
              "value": "={{ $json.body.record.email }}"
            },
            {
              "name": "form_submission[custom_3]",
              "value": "={{ $json.body.record.report_text }}"
            },
            {
              "name": "form_submission[custom_4]",
              "value": "={{ $json.body.record.grade }}"
            },
            {
              "name": "form_submission[custom_5]",
              "value": "={{ $json.body.record.result_category }}"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Supabase Insert Webhook": {
      "main": [
        [
          {
            "node": "Submit to Kajabi Form",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
